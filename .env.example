# Auth0 SPA (Stack tenant) — create a dedicated Wealth Academy application in Auth0.
# Callback URLs: http://localhost:5173, https://wealthacademy.stackby.me
VITE_AUTH0_DOMAIN=auth.stackx.me
VITE_AUTH0_CLIENT_ID=
# Optional — Stack API audience (required for Mongo persistence)
VITE_AUTH0_AUDIENCE=http://stack/api
# Gateway REST host (prod)
VITE_API_HOST=https://api.stackx.me
